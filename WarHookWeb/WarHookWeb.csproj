<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WarHookWeb</RootNamespace>
    <AssemblyName>WarHookWeb</AssemblyName>
    <DefineConstants>$(DefineConstants);WEB</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.13" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game sources shared with the desktop PyoroGL project. The web host
       supplies its own entry point; WineCompatibility stays desktop-only. -->
  <ItemGroup>
    <Compile Include="..\PyoroGL\UfoGame.cs" Link="UfoGame.cs" />
    <Compile Include="..\PyoroGL\UfoAltitudeDefense.cs" Link="UfoAltitudeDefense.cs" />
    <Compile Include="..\PyoroGL\UfoProgression.cs" Link="UfoProgression.cs" />
    <Compile Include="..\PyoroGL\UfoSaveMenu.cs" Link="UfoSaveMenu.cs" />
    <Compile Include="..\PyoroGL\UfoUpgradeMap.cs" Link="UfoUpgradeMap.cs" />
    <Compile Include="..\PyoroGL\UfoRoundResults.cs" Link="UfoRoundResults.cs" />
    <Compile Include="..\PyoroGL\UfoCrashLanding.cs" Link="UfoCrashLanding.cs" />
    <Compile Include="..\PyoroGL\UfoSmokeChecks.cs" Link="UfoSmokeChecks.cs" />
    <Compile Include="..\PyoroGL\Game1.cs" Link="Game1.cs" />
    <Compile Include="..\PyoroGL\GameB.cs" Link="GameB.cs" />
    <Compile Include="..\PyoroGL\GameMenus.cs" Link="GameMenus.cs" />
    <Compile Include="..\PyoroGL\GameKeyboard.cs" Link="GameKeyboard.cs" />
    <Compile Include="..\PyoroGL\ScoreMenus.cs" Link="ScoreMenus.cs" />
    <Compile Include="..\PyoroGL\HighScoreStore.cs" Link="HighScoreStore.cs" />
    <Compile Include="..\PyoroGL\MusicTracks.cs" Link="MusicTracks.cs" />
    <Compile Include="..\PyoroGL\BeamAudio.cs" Link="BeamAudio.cs" />
    <Compile Include="..\PyoroGL\Font6.cs" Link="Font6.cs" />
    <Compile Include="..\PyoroGL\GameAssets.cs" Link="GameAssets.cs" />
    <Compile Include="..\PyoroGL\OnlineScores.cs" Link="OnlineScores.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Leaderboard config embedded at compile time from the same file the
         desktop build uses (written by setup-leaderboards.sh; git-ignored). -->
    <EmbeddedResource Include="..\PyoroGL\supabase.json" Condition="Exists('..\PyoroGL\supabase.json')" LogicalName="supabase.json" />
  </ItemGroup>

  <!-- Loose runtime assets (PNGs loaded via Texture2D.FromStream, OGG music,
       generated-audio config), mirrored from the desktop csproj asset list. -->
  <ItemGroup>
    <Content Include="..\PyoroGL\Assets\*.ogg" Link="wwwroot\Assets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\PyoroGL\Assets\ufo-atlas.png;..\PyoroGL\Assets\beam-audio.json;..\PyoroGL\Assets\parachute.png;..\PyoroGL\Assets\mainmenu.png;..\PyoroGL\Assets\tank-pixelart.png;..\PyoroGL\Assets\mortars-pixelart-cleaned.png;..\PyoroGL\Assets\framewide.png;..\PyoroGL\Assets\newbackdrop.png;..\PyoroGL\Assets\font8x8_atlas.png;..\PyoroGL\Assets\frame_panel.png;..\PyoroGL\Assets\block_atlas.png"
             Link="wwwroot\Assets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- KNI-compatible SpriteFont XNB files are checked into wwwroot/Content.
       They were built with KNI's BlazorGL content builder; keeping them here
       avoids a platform-specific FreeType dependency during normal builds. -->

</Project>
