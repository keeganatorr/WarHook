<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MonogameTest</RootNamespace>
    <AssemblyName>MonogameTest</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy only compiled XNB assets to output; keep spritefont/mgcb sources
         out of the runtime Content folder. -->
    <None Include="Content/**/*.xnb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Rebuild the MonoGame content (sprites, fonts) before compiling so that
       pressing F5 always produces fresh .xnb files from Content.mgcb. Uses the
       global dotnet-mgcb tool via its full shim path (PATH may not include
       ~/.dotnet/tools under MSBuild/VS). -->
  <Target Name="BuildContent" BeforeTargets="Build">
    <Exec Command="&quot;$(HOME)/.dotnet/tools/mgcb&quot; &quot;Content/Content.mgcb&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <!-- Raw PNGs loaded at runtime via Texture2D.FromStream (loadPng) from the
         output Assets/ folder. Copied on EVERY build so edits always propagate
         when pressing F5. -->
    <None Update="Assets/tractorbeam-pixelart.png;Assets/tank-pixelart.png;Assets/mortars-pixelart-cleaned.png;Assets/framewide.png;Assets/newbackdrop.png;Assets/score.png;Assets/highscore.png;Assets/numbers.png"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>