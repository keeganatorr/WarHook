<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MonogameTest</RootNamespace>
    <AssemblyName>WarHook</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Stay architecture-neutral so a RuntimeIdentifier (win-x64/linux-x64)
         can never conflict with an inherited x86 PlatformTarget. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy only compiled XNB assets to output; keep spritefont/mgcb sources
         out of the runtime Content folder. -->
    <None Include="Content/**/*.xnb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README-dist.txt" TargetPath="README.txt" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Rebuild the MonoGame content (sprites, fonts) before compiling so that
       builds always produce fresh .xnb files from Content.mgcb. Uses the
       global dotnet-mgcb tool; resolves the tool shim cross-platform
       (~/.dotnet/tools on Linux/macOS, %USERPROFILE%\.dotnet\tools on Windows). -->
  <Target Name="BuildContent" BeforeTargets="Build">
    <PropertyGroup>
      <MGCBHome Condition="'$(MGCBHome)' == '' AND '$(HOME)' != ''">$(HOME)/.dotnet/tools</MGCBHome>
      <MGCBHome Condition="'$(MGCBHome)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)\.dotnet\tools</MGCBHome>
      <MGCBExe Condition="'$(MGCBExe)' == ''">&quot;$(MGCBHome)/mgcb&quot;</MGCBExe>
      <MGCBExe Condition="!Exists('$(MGCBHome)/mgcb') AND Exists('$(MGCBHome)/mgcb.exe')">&quot;$(MGCBHome)/mgcb.exe&quot;</MGCBExe>
    </PropertyGroup>
    <!-- Run inside Content/ so /outputDir:. resolves next to the .mgcb, not in
         the project root (mgcb resolves relative paths from the CWD). -->
    <Exec Command="$(MGCBExe) Content.mgcb" WorkingDirectory="$(MSBuildProjectDirectory)/Content" />
    <!-- DesktopGL effects carry OpenGL shader bytecode. Build the CRT pass
         separately so the checked-in SpriteFont XNBs keep their established
         platform format. -->
    <Exec Command="$(MGCBExe) /platform:DesktopGL /outputDir:. /intermediateDir:obj/Crt /importer:EffectImporter /processor:EffectProcessor /build:crt.fx" WorkingDirectory="$(MSBuildProjectDirectory)/Content" />
  </Target>

  <!-- Single-file publish settings for win-x64 / linux-x64 -->
  <PropertyGroup>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(NT)' != ''">win-x64</RuntimeIdentifier>
    <!-- MonoGame loads SDL/OpenAL by filename. Windows/Wine needs these DLLs
         beside the executable rather than hidden in the single-file bundle. -->
    <IncludeNativeLibrariesForSelfExtract Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">false</IncludeNativeLibrariesForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(IncludeNativeLibrariesForSelfExtract)' == ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the leaderboard config at compile time so no plaintext key
         file ships in release outputs. Written by setup-leaderboards.sh;
         git-ignored. -->
    <EmbeddedResource Include="supabase.json" Condition="Exists('supabase.json')" LogicalName="supabase.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw PNGs loaded at runtime via Texture2D.FromStream (loadPng) from the
         output Assets/ folder. Copied on EVERY build so edits always propagate
         when pressing F5. -->
    <None Update="Assets/beam-audio.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Update="Assets/ufo-atlas.png;Assets/ufo-abducted-soldier.png;Assets/ufo-abducted-engineer.png;Assets/explosion-new.png;Assets/parachute.png;Assets/mainmenu.png;Assets/title.png;Assets/tank-pixelart.png;Assets/mortars-pixelart-cleaned.png;Assets/framewide.png;Assets/newbackdrop.png;Assets/score.png;Assets/highscore.png;Assets/numbers.png;Assets/font8x8_atlas.png;Assets/upgrade-icons.png;Assets/frame_panel.png;Assets/block_atlas.png;Assets/menu.ogg;Assets/gameplay1.ogg;Assets/gameplay2.ogg;Assets/gameplay3.ogg;Assets/gameplay4.ogg;Assets/gameplay5.ogg;Assets/gameover.ogg"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
